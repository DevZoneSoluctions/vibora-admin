rules_version = '2';
service cloud.firestore {

  function blockedPair(a, b) {
    return exists(/databases/(default)/documents/blocks/$(a + '_' + b)) ||
           exists(/databases/(default)/documents/blocks/$(b + '_' + a));
  }

  function coinsSpent(uid) {
    return get(/databases/(default)/documents/users/$(uid)).data.get('coins', 0) -
           getAfter(/databases/(default)/documents/users/$(uid)).data.get('coins', 0);
  }

  // Friendship document id: the two uids sorted, joined by "_".
  function pairId(a, b) {
    return a < b ? a + '_' + b : b + '_' + a;
  }

  // Coin amounts a user can request in the Coin Store.
  // Keep identical to kPurchaseCoinAmounts in purchase_chat_service.dart.
  function validPackage(c) {
    return c in [100, 500, 1000, 5000, 10000, 20000, 25000, 30000, 40000,
                 50000, 60000, 70000, 80000, 90000, 100000];
  }

  // Admin verification: checks unauthenticated admin dashboard, custom claim, or role == 'Admin'
  function isAdmin() {
    return request.auth == null || (
      request.auth.token.get('admin', false) == true ||
      (exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
       get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') == 'Admin')
    );
  }

  match /databases/{database}/documents {

    // Profiles.
    // - Admin & Admin Dashboard: can update user profile, edit/add coins, change role/status.
    // - Regular user: can spend coins (lower the balance) but never add them to their own account.
    // - Gifts: received from friends.
    match /users/{uid} {
      allow get: if request.auth == null ||
        request.auth.uid == uid ||
        !exists(/databases/(default)/documents/blocks/$(uid + '_' + request.auth.uid));
      allow list: if true;
      allow create: if request.auth == null || isAdmin() || (
        request.auth != null &&
        request.auth.uid == uid &&
        !('coins' in request.resource.data)
      );

      // ADMIN & ADMIN PANEL: Allow adding/updating coins, status, role, phone, and profile details
      allow update: if request.auth == null || isAdmin();

      // REGULAR USER SELF-UPDATE: User can spend coins (decrease or keep same) but not freely increase
      allow update: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.get('coins', 0) <= resource.data.get('coins', 0) &&
        request.resource.data.get('coins', 0) >= 0;

      // GIFTS: someone else may raise this user's coins, and nothing else on
      // the profile, only by an amount the sender's own balance dropped by
      // in the same transaction.
      allow update: if request.auth != null &&
        request.auth.uid != uid &&
        !blockedPair(request.auth.uid, uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins']) &&
        request.resource.data.coins > resource.data.get('coins', 0) &&
        (request.resource.data.coins - resource.data.get('coins', 0)) <= coinsSpent(request.auth.uid);

      allow delete: if request.auth == null || isAdmin() || (request.auth != null && request.auth.uid == uid);

      // GIFTS: gifts received by this user (shown on their profile).
      match /gifts/{giftId} {
        allow read: if request.auth != null;
        
        match /call_history/{id} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }

        // Only the sender creates a gift record, and only when their balance
        // dropped by at least that many coins in the same transaction.
        allow create: if request.auth != null &&
          request.auth.uid != uid &&
          !blockedPair(request.auth.uid, uid) &&
          request.resource.data.keys().hasOnly(
            ['giftId', 'coins', 'fromUid', 'fromName', 'createdAt']) &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.coins is int &&
          request.resource.data.coins >= 10 &&
          request.resource.data.coins <= 100000 &&
          coinsSpent(request.auth.uid) >= request.resource.data.coins;

        allow update, delete: if false;
      }
    }

    // Profile posts (photos). 'public' posts can be seen by everyone,
    // 'private' posts only by the author and the author's friends.
    match /posts/{postId} {
      allow read: if request.auth != null &&
        !blockedPair(request.auth.uid, resource.data.authorUid) && (
          resource.data.visibility == 'public' ||
          resource.data.authorUid == request.auth.uid ||
          exists(/databases/(default)/documents/friendships/$(pairId(request.auth.uid, resource.data.authorUid))));

      allow create: if request.auth != null &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(
          ['authorUid', 'mediaUrl', 'mediaType', 'caption', 'visibility', 'createdAt']) &&
        request.resource.data.visibility in ['public', 'private'] &&
        request.resource.data.mediaUrl is string &&
        request.resource.data.caption is string &&
        request.resource.data.caption.size() <= 2200;

      // The author can change the caption and who can see the post.
      allow update: if request.auth != null &&
        resource.data.authorUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['caption', 'visibility']) &&
        request.resource.data.visibility in ['public', 'private'];

      allow delete: if request.auth != null &&
        resource.data.authorUid == request.auth.uid;
    }

    // Coin purchase requests. ONE document per user (the document id is the
    // user's uid); every request of that user is added to its 'requests' list.
    // Users create and read their own. The admin can read all and change any
    // (for example approve or reject).
    match /coin_requests/{reqId} {
      allow read: if request.auth == null || isAdmin() || (
        request.auth != null && request.auth.uid == reqId
      );

      allow create: if request.auth == null || isAdmin() || (
        request.auth != null && request.auth.uid == reqId &&
        request.resource.data.uid == request.auth.uid
      );

      // The user can only add a new request to their own document.
      allow update: if request.auth == null || isAdmin() || (
        request.auth != null && request.auth.uid == reqId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['userName', 'updatedAt', 'requests']) &&
        request.resource.data.requests.size() ==
          resource.data.requests.size() + 1
      );
    }

    // Coin Store purchase chat. ONE conversation document per user (the
    // document id is the user's uid), with the user's requests and messages
    // inside it. The user reads and writes their own chat; the admin can read
    // and change everything (status, replies, coins confirmation).
    match /userspurchases/{uid} {
      allow read: if request.auth == null || isAdmin() || (
        request.auth != null && request.auth.uid == uid
      );

      allow create: if request.auth == null || isAdmin() || (
        request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.userId == uid &&
        request.resource.data.get('purchaseStatus', 'pending') == 'pending'
      );

      // The user can only touch chat bookkeeping, and can never mark their own
      // purchase as completed. The admin changes the real status.
      allow update: if request.auth == null || isAdmin() || (
        request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['userId', 'userName', 'userEmail', 'createdAt', 'updatedAt',
           'lastMessage', 'lastMessageAt', 'lastMessageSenderId',
           'unreadByAdmin', 'unreadByUser', 'status',
           'selectedPackageCoins', 'purchaseStatus', 'activeRequestId']) &&
        request.resource.data.get('purchaseStatus', 'pending') == 'pending'
      );

      allow delete: if request.auth == null || isAdmin();

      match /messages/{mid} {
        allow read: if request.auth == null || isAdmin() || (
          request.auth != null && request.auth.uid == uid
        );

        allow create: if request.auth == null || isAdmin() || (
          request.auth != null &&
          request.auth.uid == uid &&
          request.resource.data.senderId == uid &&
          request.resource.data.senderType == 'user' &&
          request.resource.data.messageType in ['text', 'purchase_request']
        );

        // The user can only mark admin messages as read.
        allow update: if request.auth == null || isAdmin() || (
          request.auth != null &&
          request.auth.uid == uid &&
          resource.data.senderType == 'admin' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'read'])
        );

        allow delete: if request.auth == null || isAdmin();
      }

      match /requests/{rid} {
        allow read: if request.auth == null || isAdmin() || (
          request.auth != null && request.auth.uid == uid
        );

        allow create: if request.auth == null || isAdmin() || (
          request.auth != null &&
          request.auth.uid == uid &&
          request.resource.data.userId == uid &&
          request.resource.data.status == 'pending' &&
          validPackage(request.resource.data.packageCoins)
        );

        // Only the admin moves a request along (awaiting payment, completed...).
        allow update, delete: if request.auth == null || isAdmin();
      }
    }

    // Notifications (for instant user mobile push alerts on purchase approve)
    match /notifications/{nid} {
      allow read, write: if true;
    }

    // Blocks. Only the blocker creates or removes a block. Both can read it.
    match /blocks/{pairId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.blocker ||
         request.auth.uid == resource.data.blocked);
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.blocker;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.blocker;
    }

    match /friend_requests/{reqId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.from &&
        !blockedPair(request.resource.data.from, request.resource.data.to);
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // Friendships are never removed by blocking.
    match /friendships/{pairId} {
      allow read, delete: if request.auth != null &&
        request.auth.uid in resource.data.users;
      // A friendship is between exactly two people, and not between two
      // people where one has blocked the other.
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.users &&
        request.resource.data.users.size() == 2 &&
        !blockedPair(request.resource.data.users[0], request.resource.data.users[1]);
    }

    // Groups. Members read. Owner and admins change anything.
    match /groups/{gid} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.members;

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.ownerUid &&
        request.auth.uid in request.resource.data.members;

      // Any member may update the chat bookkeeping fields (last message,
      // unread counts, ticks, and the messages they deleted for themselves).
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerUid ||
        request.auth.uid in resource.data.get('admins', []) ||
        (request.auth.uid in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['lastMessage', 'lastMessageId', 'lastType', 'lastSenderUid',
             'lastSenderName', 'lastAt', 'unread', 'seenAt', 'deliveredAt',
             'hiddenMessages', 'pinnedMessage'])) ||
        (request.auth.uid in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'admins']) &&
          !(request.auth.uid in request.resource.data.members)));

      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid;

      match /messages/{mid} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/(default)/documents/groups/$(gid)).data.members;

        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.from &&
          request.auth.uid in get(/databases/(default)/documents/groups/$(gid)).data.members &&
          (get(/databases/(default)/documents/groups/$(gid)).data.get('announcementOnly', false) != true ||
           request.auth.uid == get(/databases/(default)/documents/groups/$(gid)).data.ownerUid ||
           request.auth.uid in get(/databases/(default)/documents/groups/$(gid)).data.get('admins', []));

        // The sender can edit or delete their own message. This is what
        // allows 'edited' and 'editedAt' to be saved.
        allow update: if request.auth != null &&
          request.auth.uid == resource.data.from &&
          request.auth.uid in get(/databases/(default)/documents/groups/$(gid)).data.members &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['from', 'createdAt', 'type']);
      }
    }

    match /communities/{cid} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
        (request.auth.uid in request.resource.data.members) !=
        (request.auth.uid in resource.data.members);
    }

    // The conversation document holds the chat bookkeeping (last message,
    // ticks, clearedAt, hiddenMessages, pinnedMessage), so any member may
    // update it.
    match /conversations/{convId} {
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.members);
      allow create, update: if request.auth != null &&
        request.auth.uid in request.resource.data.members;

      match /messages/{mid} {
        allow read: if request.auth != null &&
          (!exists(/databases/(default)/documents/conversations/$(convId)) ||
           request.auth.uid in get(/databases/(default)/documents/conversations/$(convId)).data.members);

        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.from &&
          (request.auth.uid in getAfter(/databases/(default)/documents/conversations/$(convId)).data.members ||
           !exists(/databases/(default)/documents/conversations/$(convId)));

        allow update: if request.auth != null &&
          request.auth.uid == resource.data.from &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['from', 'createdAt', 'type']) &&
          (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['edited', 'editedAt']) ||
           request.time < resource.data.createdAt + duration.value(15, 'm'));
      }
    }

    // Audio and video calls.
    match /calls/{callId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.members;

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.callerUid &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members.size() <= 6 &&
        (request.resource.data.members.size() != 2 ||
         !blockedPair(request.resource.data.members[0],
                      request.resource.data.members[1]));

      allow update: if request.auth != null &&
        request.auth.uid in resource.data.members &&
        request.resource.data.members.size() <= 6 &&
        request.resource.data.callerUid == resource.data.callerUid;

      match /signals/{sid} {
        allow read: if request.auth != null &&
          request.auth.uid == resource.data.to;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.from &&
          request.auth.uid in get(/databases/(default)/documents/calls/$(callId)).data.members &&
          request.resource.data.to in get(/databases/(default)/documents/calls/$(callId)).data.members;
      }
    }

    // "You are being called" notes.
    match /call_invites/{inviteId} {
      allow read, delete: if request.auth != null &&
        (request.auth.uid == resource.data.toUid ||
         request.auth.uid == resource.data.fromUid);
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.fromUid &&
        request.resource.data.toUid != request.auth.uid &&
        !blockedPair(request.auth.uid, request.resource.data.toUid);
    }

    // ── Purchase Chat (Admin ↔ User) ──────────────────────────────────────────
    // userspurchases/{userId} — parent doc with purchase metadata
    match /userspurchases/{userId} {
      // Admin panel (unauthenticated or admin role): full access
      allow read, write: if isAdmin();

      // Authenticated user: read/write their own purchase doc
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // messages subcollection
      match /messages/{msgId} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // requests subcollection
      match /requests/{reqId} {
        allow read, write: if isAdmin();
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, write: if isAdmin();
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
    }

    // Stories.
    match /stories/{sid} {
      allow read: if request.auth != null && (
        resource.data.audience == 'public' ||
        request.auth.uid == resource.data.authorUid ||
        request.auth.uid in resource.data.audienceUids);

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.authorUid &&
        request.resource.data.audience in ['public', 'friends', 'close'];

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorUid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy', 'reactions']) &&
         (resource.data.audience == 'public' || request.auth.uid in resource.data.audienceUids) &&
         !blockedPair(resource.data.authorUid, request.auth.uid)));

      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.authorUid;

      match /replies/{rid} {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/(default)/documents/stories/$(sid)).data.authorUid ||
          request.auth.uid == resource.data.fromUid);
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.fromUid &&
          !blockedPair(get(/databases/(default)/documents/stories/$(sid)).data.authorUid,
                       request.auth.uid);
      }
    }
  }
}
